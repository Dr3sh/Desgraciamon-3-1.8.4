{
  "schemaVersion": 1,
  "id": "desgraciamon4_visuals",
  "version": "${version}",
  "name": "Desgraciamon Visuals",
  "description": "Suite unificada de efectos visuales, cinemáticas y menús dinámicos para Desgraciamon 3.",
  "authors": [
    "Desgraciamon Team"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.desgraciamon.vortex.DesgraciamonMod",
      "com.desgraciamon.cinematics.CinematicsMod"
    ],
    "client": [
      "com.desgraciamon.vortex.client.DesgraciamonClientMod",
      "com.desgraciamon.cinematics.client.CinematicsClientMod",
      "com.desgraciamon.videomenu.DesgraciamonVideoMenu"
    ]
  },
  "mixins": [
    "desgraciamon4_special_effects.mixins.json",
    "desgraciamon4_cinematics.mixins.json",
    "desgraciamon4_video_menu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.6",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cobblemon": "~1.8.4"
  },
  "provides": [
    "desgraciamon4_special_effects",
    "desgraciamon4_cinematics",
    "desgraciamon4_video_menu"
  ]
}
